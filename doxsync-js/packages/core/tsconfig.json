{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM",
      "ESNext.Disposable"
    ],
    "strict": true,
    "declaration": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "rootDirs": [
      "src",
      "dist"
    ],
    "outDir": "dist",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
