{
  "name": "doxsync",
  "version": "0.1.0-alpha.1",
  "description": "JavaScript bindings for the doxsync Rust synchronization engine",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/index.d.ts",
